# Copy to .env and fill in. .env holds secrets: never share or commit it.
GEMINI_API_KEY=
WEBHOOK_KEY=                 # python -m examples.admin new-webhook-key
DATABASE_URL=postgresql+psycopg://postgres:test@127.0.0.1:55432/quiz
REDIS_URL=redis://127.0.0.1:56379/0
STORAGE_DIR=var/storage      # or S3_BUCKET + S3_ENDPOINT_URL + S3_REGION (+ AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
PROBE_CONCURRENCY=4
